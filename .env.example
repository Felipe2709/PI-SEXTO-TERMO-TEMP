# Conexão com o MongoDB da Fatec
MONGO_URI=mongodb://root:<SENHA>@<HOST>:27017/?authSource=admin
MONGO_DB=iot
MONGO_COLLECTION=sensores

# Conexão opcional com o MariaDB (usado em consulta.py)
MARIADB_HOST=<HOST>
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=<SENHA>
MARIADB_DATABASE=fatec_iot
